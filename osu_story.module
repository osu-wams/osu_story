<?php

/**
 * @file
 * OSU Story Module.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\node\NodeInterface;
use Drupal\osu_story\Hook\OsuStoryNodeHooks;

/**
 * Implements hook_ENTITY_TYPE_insert().
 *
 * After a new node is saved, we need to regenerate the XML Sitemap.
 */
#[LegacyHook]
function osu_story_node_insert(NodeInterface $node) {
  Drupal::service(OsuStoryNodeHooks::class)->nodeInsert($node);
}

/**
 * Implements hook_ENTITY_TYPE_update().
 *
 * On update, we need to regenerate the XML Sitemap.
 */
#[LegacyHook]
function osu_story_node_update(NodeInterface $node) {
  Drupal::service(OsuStoryNodeHooks::class)->nodeUpdate($node);
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 */
#[LegacyHook]
function osu_story_node_presave(NodeInterface $node) {
  Drupal::service(OsuStoryNodeHooks::class)->nodePreSave($node);
}
