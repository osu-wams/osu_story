{
  "name": "osu-wams/osu_story",
  "description": "Provides a story content type and views to be used as News articles, Featured stories etc.",
  "minimum-stability": "stable",
  "type": "drupal-custom-module",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Matthew Brabham",
      "email": "matthew.brabham@oregonstate.edu"
    }
  ],
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "squizlabs/php_codesniffer": "^4.0",
    "drupal/coder": "^9.0",
    "drupol/phpcsfixer-configs-drupal": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.95",
    "vincentlanglet/twig-cs-fixer": "^4.1"
  },
  "scripts": {
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "cs-checkstyle": "phpcs -q --report=checkstyle",
    "twigcs": "twigcs"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
